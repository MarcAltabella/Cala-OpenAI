{
  "name": "cala-healthcare-intelligence",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "pnpm --filter @cala/web dev",
    "dev:api": "pnpm --filter @cala/api dev",
    "dev:worker": "pnpm --filter @cala/worker dev",
    "start": "pnpm dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@cala/agents": "workspace:*",
    "@cala/contracts": "workspace:*",
    "@cala/db": "workspace:*",
    "@cala/graph": "workspace:*",
    "@cala/ingestion": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
